@model WebApp2ByChirag.Models.Student
@{
    ViewData["Title"] = "Student Details";
}

<h2>Student Details</h2>
<table class="table table-bordered">
    <tr><th>Student ID</th><td>@Model.StdID</td></tr>
    <tr><th>Name</th><td>@Model.Name</td></tr>
    <tr><th>Address</th><td>@Model.Address</td></tr>
    <tr><th>Faculty</th><td>@Model.Faculty</td></tr>
    <tr><th>Roll No</th><td>@Model.RollNo</td></tr>
</table>
